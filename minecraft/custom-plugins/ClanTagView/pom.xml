<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>net.totemcraft</groupId>
    <artifactId>clantagview</artifactId>
    <version>1.2.1</version>
    <packaging>jar</packaging>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <repositories>
        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
    </repositories>

    <dependencies>
        <!-- Только стабильный API Paper: без NMS, чтобы переживать обновления игры -->
        <dependency>
            <groupId>io.papermc.paper</groupId>
            <artifactId>paper-api</artifactId>
            <version>1.21.1-R0.1-SNAPSHOT</version>
            <scope>provided</scope>
        </dependency>
        <!-- API SimpleClans берётся из jar с сервера при сборке, в наш jar не попадает -->
        <dependency>
            <groupId>net.sacredlabyrinth</groupId>
            <artifactId>simpleclans</artifactId>
            <version>2.19.2</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/lib/simpleclans.jar</systemPath>
        </dependency>
        <!-- Режим чата игрока (общий/ближний) берётся из Essentials, в наш jar не попадает -->
        <dependency>
            <groupId>net.essentialsx</groupId>
            <artifactId>essentialsx</artifactId>
            <version>2.22.0</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/lib/essentials.jar</systemPath>
        </dependency>
        <!-- Вход игрока и сверка пароля для /l (она же /login в AuthMe) -->
        <dependency>
            <groupId>fr.xephi</groupId>
            <artifactId>authme</artifactId>
            <version>6.0.1</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/lib/authme.jar</systemPath>
        </dependency>
        <!-- Фильтр ближнего чата для Discord -->
        <dependency>
            <groupId>com.discordsrv</groupId>
            <artifactId>discordsrv</artifactId>
            <version>1.30.5</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/lib/discordsrv.jar</systemPath>
        </dependency>
    </dependencies>

    <build>
        <finalName>clantagview-${project.version}</finalName>
    </build>
</project>

{
  "name": "totembots",
  "version": "0.1.0",
  "description": "TotemBots: боты-компаньоны для серверов Minecraft",
  "main": "app/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node test/models.js",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^39.8.10",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "@fontsource/alegreya": "^5.3.0",
    "@fontsource/pixelify-sans": "^5.3.0",
    "mineflayer": "^4.39.0",
    "mineflayer-pathfinder": "^2.4.5",
    "vec3": "^0.2.0"
  },
  "build": {
    "appId": "net.totemcraft.totembots",
    "productName": "TotemBots",
    "asarUnpack": ["app/*.py"],
    "files": [
      "app/**/*",
      "package.json",
      "!app/**/*.bak",
      "!local/**",
      "!test/**",
      "!**/*.log"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TotemBots",
      "deleteAppDataOnUninstall": false
    }
  }
}